# Copy to .env (app) and .env.test (database tests). Both files are gitignored.

# --- App (.env) -------------------------------------------------------------
# Only these two may reach the client: the project URL and the publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Tests only (.env.test) -------------------------------------------------
# Never put the secret key in .env, never prefix it with VITE_, never commit it.
# Point these at the separate test project, not at production.
TEST_PROJECT_REF=
TEST_DATABASE_URL=
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SECRET_KEY=
# Ref of the production project. The test runner refuses to run against it.
PRODUCTION_PROJECT_REF=
